   "source": [
    "import shutil\n",
    "\n",
    "# Copy positive images into verification_images folder\n",
    "pos_images = os.listdir(POS_PATH)[:50]  # 50 reference images is enough\n",
    "\n",
    "for img in pos_images:\n",
    "    shutil.copy(\n",
    "        os.path.join(POS_PATH, img),\n",
    "        os.path.join('application_data', 'verification_images', img)\n",
    "    )\n",
    "\n",
    "print(f\"Copied {len(pos_images)} images into verification_images/\")\n",
    "print(os.listdir(os.path.join('application_data', 'verification_images'))[:5])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 39,
   "id": "a4ced35c-d75e-40ba-866e-98f3b4d3f0aa",
   "metadata": {},
   "outputs": [],
   "source": [
    "def verify(model, detection_threshold, verification_threshold):\n",
    "    verification_images = os.listdir(os.path.join('application_data', 'verification_images'))\n",
    "    \n",
    "    if not verification_images:\n",
    "        return [], False\n",
    "    \n",
    "    results = []\n",
    "    for image in verification_images:\n",
    "        input_img = preprocess(os.path.join('application_data', 'input_image', 'input_image.jpg'))\n",
    "        validation_img = preprocess(os.path.join('application_data', 'verification_images', image))\n",
    "        \n",
    "        result = model.predict(\n",
    "            [np.expand_dims(input_img, axis=0), np.expand_dims(validation_img, axis=0)],\n",
    "            verbose=0\n",
    "        )\n",
    "        results.append(result[0][0])  # extract the scalar probability\n",
    "    \n",
    "    results = np.array(results)  # now shape (N,) — clean 1D array\n",
    "    \n",
    "    detection = np.sum(results > detection_threshold)\n",
    "    verification = detection / len(verification_images)\n",
    "    verified = verification > verification_threshold\n",
    "    \n",
    "    return results, verified"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 40,
   "id": "ab3f6341-9205-4b8f-bf9e-5498e253f842",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "True\n",
      "True\n",
      "True\n",
      "True\n",
      "False\n"
     ]
    }
   ],
   "source": [
    "cap = cv2.VideoCapture(0)\n",
    "while cap.isOpened():\n",
    "    ret, frame = cap.read()\n",
    "\n",
    "    frame = cv2.resize(frame, (250, 250))\n",
    "\n",
    "    cv2.imshow('Verification', frame)\n",
    "\n",
    "    # Verification trigger\n",
    "    if cv2.waitKey(10) & 0xFF == ord('v'):\n",
    "        cv2.imwrite(os.path.join('application_data', 'input_image', 'input_image.jpg'), frame)\n",
    "        # Run verification\n",
    "        results, verified = verify(siamese_model, 0.5, 0.5)\n",
    "        print(verified)\n",
    "\n",
    "    if cv2.waitKey(10) & 0xFF == ord('q'):\n",
    "        break\n",
    "\n",
    "cap.release()\n",
    "cv2.destroyAllWindows()"
   ]
  },
